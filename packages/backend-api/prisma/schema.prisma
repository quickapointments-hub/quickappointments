// Quick Appointments Database Schema
// Fully normalized architecture adhering to enterprise multi-tenant design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  phone        String         @unique
  email        String?        @unique
  fullName     String
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  roles        UserRoleItem[]
  sessions     UserSession[]
  otpCodes     OtpVerification[]
  customer     CustomerProfile?
  provider     ProviderProfile?
  adminProfile AdminUser?
  notifications Notification[]
  auditLogs    AuditLog[]
  supportTickets SupportTicket[]
  deviceTokens DeviceToken[]
}

model UserRoleItem {
  id        String   @id @default(uuid())
  userId    String
  role      String   // CUSTOMER, PROVIDER, ADMIN, SUPERADMIN
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  city           String?
  defaultAddress String?
  latitude       Float?
  longitude      Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  reservations   SlotReservation[]
  reviews        Review[]
  savedAddresses SavedAddress[]
}

model ProviderProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  providerType        String             @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS
  businessName        String?
  tagline             String?
  bio                 String?
  experienceYears     Int                @default(1)
  ratingAvg           Float              @default(5.0)
  ratingCount         Int                @default(0)
  verificationStatus  String             @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  rejectionReason     String?
  isAcceptingBookings Boolean            @default(true)
  city                String
  address             String
  latitude            Float?
  longitude           Float?
  serviceRadiusKm     Float              @default(20.0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           ProviderDocument[]
  workingHours        ProviderWorkingHour[]
  branches            ProviderBranch[]
  staff               ProviderStaff[]
  customServices      ProviderServiceRate[]
  bookings            Booking[]
  reservations        SlotReservation[]
  earnings            ProviderEarning[]
  reviews             Review[]
  bankAccount         ProviderBankAccount?
  payoutItems         PayoutItem[]
}

model ProviderDocument {
  id             String   @id @default(uuid())
  providerId     String
  documentType   String   // AADHAAR, PAN, BUSINESS_LICENSE, TRADE_CERTIFICATE
  documentNumber String?
  fileUrl        String
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderWorkingHour {
  id         String   @id @default(uuid())
  providerId String
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday ... 6 = Saturday
  openTime   String   // "09:00"
  closeTime  String   // "18:00"
  isClosed   Boolean  @default(false)
  breakStart String?  // "13:00"
  breakEnd   String?  // "14:00"

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  iconUrl      String?
  imageUrl     String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services       Service[]
  cityCategories CityCategory[]
}

model Service {
  id              String    @id @default(uuid())
  categoryId      String
  name            String
  slug            String    @unique
  description     String
  durationMinutes Int       @default(60)
  basePrice       Float
  imageUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerRates   ProviderServiceRate[]
  bookings        Booking[]
  reservations    SlotReservation[]
}

model ProviderServiceRate {
  id             String   @id @default(uuid())
  providerId     String
  serviceId      String
  customPrice    Float?
  customDuration Int?
  approvalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED (Admin approval required)
  isActive       Boolean  @default(true)

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model SlotReservation {
  id         String   @id @default(uuid())
  providerId String
  serviceId  String
  customerId String
  date       String   // "YYYY-MM-DD"
  startTime  String   // "10:00"
  endTime    String   // "11:00"
  expiresAt  DateTime
  isReleased Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId, date, startTime])
}

model Booking {
  id                 String   @id @default(uuid())
  bookingRef         String   @unique
  customerId         String
  providerId         String
  serviceId          String
  status             String   @default("CONFIRMED") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, RESCHEDULED
  date               String   // "YYYY-MM-DD"
  startTime          String   // "10:00"
  endTime            String   // "11:00"
  notes              String?
  
  servicePrice       Float
  discountAmount     Float    @default(0.0)
  taxAmount          Float    @default(0.0)
  totalAmount        Float
  platformCommission Float    @default(0.0)
  providerEarnings   Float
  
  paymentStatus      String   @default("PAID") // PENDING, PROCESSING, PAID, FAILED, REFUNDED
  paymentMethod      String   @default("CASH_ON_SERVICE")
  paymentRef         String?
  serviceOtp         String?  // 6-digit customer verification OTP to start/complete service
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider           ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  history            BookingStatusHistory[]
  paymentTx          PaymentTransaction[]
  review             Review?
  refund             Refund?

  @@index([providerId, date])
  @@index([customerId])
}

model BookingStatusHistory {
  id        String   @id @default(uuid())
  bookingId String
  status    String
  reason    String?
  changedBy String?
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String   @default("INR")
  status        String   // PENDING, SUCCESS, FAILED, REFUNDED
  gateway       String   @default("RAZORPAY")
  gatewayTxId   String?  @unique
  rawPayload    String?
  createdAt     DateTime @default(now())

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model ProviderEarning {
  id             String   @id @default(uuid())
  providerId     String
  bookingId      String   @unique
  grossAmount    Float
  commissionRate Float
  platformFee    Float
  netEarnings    Float
  isSettled      Boolean  @default(false)
  settledAt      DateTime?
  createdAt      DateTime @default(now())

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model CommissionSetting {
  id            String   @id @default(uuid())
  type          String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  rate          Float    @default(5.0) // 5% default platform commission
  categoryId    String?
  providerId    String?
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?  // JSON string
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id          String   @id @default(uuid())
  userId      String   @unique
  department  String?
  permissions String   // comma-separated or JSON
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "PROVIDER_APPROVED", "PRICE_UPDATED"
  entityType String   // e.g. "ProviderProfile", "Booking"
  entityId   String
  details    String?  // JSON payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  customerId String
  providerId String
  rating     Float    // 1.0 to 5.0
  tags       String?  // JSON string e.g. ["On time", "Professional"]
  comment    String?
  reply      String?
  createdAt  DateTime @default(now())

  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  discountType      String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  value             Float
  minOrderAmount    Float     @default(0.0)
  maxDiscountAmount Float?
  usageLimit        Int?
  usedCount         Int       @default(0)
  expiresAt         DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

model Refund {
  id              String    @id @default(uuid())
  bookingId       String    @unique
  amount          Float
  reason          String
  status          String    @default("REQUESTED") // REQUESTED, PROCESSING, REFUNDED, FAILED
  gatewayRefundId String?
  deadline        DateTime  // 48 hours deadline
  processedAt     DateTime?
  adminRemarks    String?
  createdAt       DateTime  @default(now())

  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PayoutBatch {
  id             String       @id @default(uuid())
  batchRef       String       @unique
  settlementDate String       // YYYY-MM-DD
  totalAmount    Float
  providerCount  Int
  status         String       @default("PENDING") // PENDING, GENERATED, PROCESSED, FAILED
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  items          PayoutItem[]
}

model PayoutItem {
  id             String      @id @default(uuid())
  batchId        String
  providerId     String
  netAmount      Float
  bankAccountRef String?
  status         String      @default("PENDING") // PENDING, PAID, FAILED
  bankTxRef      String?
  paidAt         DateTime?

  batch          PayoutBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([providerId])
}

model ProviderBankAccount {
  id                String   @id @default(uuid())
  providerId        String   @unique
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())

  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model City {
  id         String         @id @default(uuid())
  name       String         @unique
  state      String
  latitude   Float?
  longitude  Float?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  categories CityCategory[]
}

model CityCategory {
  id         String   @id @default(uuid())
  cityId     String
  categoryId String
  isEnabled  Boolean  @default(true)

  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cityId, categoryId])
}

model SupportTicket {
  id         String          @id @default(uuid())
  ticketRef  String          @unique
  userId     String
  bookingId  String?
  category   String          // DISPUTE, PAYMENT, CANCELLATION, GENERAL
  subject    String
  status     String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority   String          @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  resolution String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  senderId      String
  senderRole    String        // CUSTOMER, PROVIDER, ADMIN
  message       String
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceType String   @default("ANDROID") // ANDROID, IOS, WEB
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedAddress {
  id           String          @id @default(uuid())
  customerId   String
  label        String          @default("Home") // Home, Work, Other
  addressLine  String
  city         String
  pincode      String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model ProviderBranch {
  id         String   @id @default(uuid())
  providerId String
  name       String
  address    String
  city       String
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staff      ProviderStaff[]

  @@index([providerId])
}

model ProviderStaff {
  id          String   @id @default(uuid())
  providerId  String
  branchId    String?
  name        String
  specialty   String?
  photoUrl    String?
  workingDays String?  @default("Mon,Tue,Wed,Thu,Fri,Sat")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  branch      ProviderBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([providerId])
}

