// Quick Appointments Database Schema
// Fully normalized architecture adhering to enterprise multi-tenant design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  phone        String         @unique
  email        String?        @unique
  fullName     String
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  roles        UserRoleItem[]
  sessions     UserSession[]
  otpCodes     OtpVerification[]
  customer     CustomerProfile?
  provider     ProviderProfile?
  adminProfile AdminUser?
  notifications Notification[]
  auditLogs    AuditLog[]
}

model UserRoleItem {
  id        String   @id @default(uuid())
  userId    String
  role      String   // CUSTOMER, PROVIDER, ADMIN, SUPERADMIN
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  city           String?
  defaultAddress String?
  latitude       Float?
  longitude      Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  reservations   SlotReservation[]
}

model ProviderProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  providerType        String             @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS
  businessName        String?
  tagline             String?
  bio                 String?
  experienceYears     Int                @default(1)
  ratingAvg           Float              @default(5.0)
  ratingCount         Int                @default(0)
  verificationStatus  String             @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  rejectionReason     String?
  isAcceptingBookings Boolean            @default(true)
  city                String
  address             String
  latitude            Float?
  longitude           Float?
  serviceRadiusKm     Float              @default(20.0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           ProviderDocument[]
  workingHours        ProviderWorkingHour[]
  customServices      ProviderServiceRate[]
  bookings            Booking[]
  reservations        SlotReservation[]
  earnings            ProviderEarning[]
}

model ProviderDocument {
  id             String   @id @default(uuid())
  providerId     String
  documentType   String   // AADHAAR, PAN, BUSINESS_LICENSE, TRADE_CERTIFICATE
  documentNumber String?
  fileUrl        String
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderWorkingHour {
  id         String   @id @default(uuid())
  providerId String
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday ... 6 = Saturday
  openTime   String   // "09:00"
  closeTime  String   // "18:00"
  isClosed   Boolean  @default(false)
  breakStart String?  // "13:00"
  breakEnd   String?  // "14:00"

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  iconUrl      String?
  imageUrl     String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[]
}

model Service {
  id              String    @id @default(uuid())
  categoryId      String
  name            String
  slug            String    @unique
  description     String
  durationMinutes Int       @default(60)
  basePrice       Float
  imageUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerRates   ProviderServiceRate[]
  bookings        Booking[]
  reservations    SlotReservation[]
}

model ProviderServiceRate {
  id             String   @id @default(uuid())
  providerId     String
  serviceId      String
  customPrice    Float?
  customDuration Int?
  isActive       Boolean  @default(true)

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model SlotReservation {
  id         String   @id @default(uuid())
  providerId String
  serviceId  String
  customerId String
  date       String   // "YYYY-MM-DD"
  startTime  String   // "10:00"
  endTime    String   // "11:00"
  expiresAt  DateTime
  isReleased Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId, date, startTime])
}

model Booking {
  id                 String   @id @default(uuid())
  bookingRef         String   @unique
  customerId         String
  providerId         String
  serviceId          String
  status             String   @default("CONFIRMED") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, RESCHEDULED
  date               String   // "YYYY-MM-DD"
  startTime          String   // "10:00"
  endTime            String   // "11:00"
  notes              String?
  
  servicePrice       Float
  discountAmount     Float    @default(0.0)
  taxAmount          Float    @default(0.0)
  totalAmount        Float
  platformCommission Float    @default(0.0)
  providerEarnings   Float
  
  paymentStatus      String   @default("PAID") // PENDING, PROCESSING, PAID, FAILED, REFUNDED
  paymentMethod      String   @default("CASH_ON_SERVICE")
  paymentRef         String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider           ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  history            BookingStatusHistory[]
  paymentTx          PaymentTransaction[]

  @@index([providerId, date])
  @@index([customerId])
}

model BookingStatusHistory {
  id        String   @id @default(uuid())
  bookingId String
  status    String
  reason    String?
  changedBy String?
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String   @default("INR")
  status        String   // PENDING, SUCCESS, FAILED, REFUNDED
  gateway       String   @default("RAZORPAY")
  gatewayTxId   String?  @unique
  rawPayload    String?
  createdAt     DateTime @default(now())

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model ProviderEarning {
  id             String   @id @default(uuid())
  providerId     String
  bookingId      String   @unique
  grossAmount    Float
  commissionRate Float
  platformFee    Float
  netEarnings    Float
  isSettled      Boolean  @default(false)
  settledAt      DateTime?
  createdAt      DateTime @default(now())

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model CommissionSetting {
  id            String   @id @default(uuid())
  type          String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  rate          Float    @default(10.0)
  categoryId    String?
  providerId    String?
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?  // JSON string
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id          String   @id @default(uuid())
  userId      String   @unique
  department  String?
  permissions String   // comma-separated or JSON
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "PROVIDER_APPROVED", "PRICE_UPDATED"
  entityType String   // e.g. "ProviderProfile", "Booking"
  entityId   String
  details    String?  // JSON payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

